<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Hire_Date_Cannot_Be_Future</fullName>
    <active>true</active>
    <errorConditionFormula>Hire_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Hire_Date__c</errorDisplayField>
    <errorMessage>Hire Date cannot be in the future.</errorMessage>
</ValidationRule>
